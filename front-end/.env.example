# Base URL REST API AsramaCare.
# Biarkan "/api" jika front-end dan back-end disajikan dari origin yang sama
# (development memakai proxy Vite, produksi memakai Express yang menyajikan dist/).
# Isi URL lengkap (mis. https://api.contoh.app/api) jika back-end di-deploy terpisah.
VITE_API_BASE_URL=/api

# Alamat back-end untuk proxy Vite saat development.
VITE_DEV_PROXY_TARGET=http://localhost:3000
