# URL REST API AsramaCare (back-end yang di-deploy terpisah), diakhiri /api.
# Produksi, contoh: VITE_API_BASE_URL=https://ifs24021-pabwe2026-proyek1-backend.vercel.app/api
# Lokal: biarkan /api agar request diteruskan proxy Vite ke VITE_DEV_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Alamat back-end lokal untuk proxy Vite saat `bun run dev`.
VITE_DEV_PROXY_TARGET=http://localhost:3000
