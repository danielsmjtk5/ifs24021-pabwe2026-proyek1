{
  "name": "asramacare-back-end",
  "version": "1.0.0",
  "description": "REST API AsramaCare (Express.js + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "migrate": "node --disable-warning=ExperimentalWarning database/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning database/seeds/seed.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
  },
  "author": "Albert",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}