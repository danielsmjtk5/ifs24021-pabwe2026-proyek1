# Lingkungan: development | production | test
NODE_ENV=development
PORT=3000

# Lokasi file SQLite. Pada hosting, arahkan ke volume persisten, misalnya /data/asramacare.db
DB_PATH=./data/asramacare.db

# Rahasia penandatanganan JWT. WAJIB diganti dengan string acak panjang (min. 32 karakter).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-minimal-32-karakter
JWT_EXPIRES_IN=1d

# Origin front-end yang diizinkan CORS (pisahkan dengan koma). Tidak diperlukan jika
# front-end disajikan dari origin yang sama (mode produksi satu layanan).
CORS_ORIGIN=http://localhost:5173

# Pengaturan cookie sesi. Gunakan "none" + COOKIE_SECURE=true jika front-end dan back-end
# berada di domain berbeda (wajib HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Akun admin awal yang dibuat oleh `npm run seed`. Ganti di produksi.
ADMIN_NAME=Admin Asrama
ADMIN_EMAIL=admin@asramacare.test
ADMIN_PASSWORD=Admin12345

# Isi true untuk membuat akun penghuni dan laporan demo saat seed.
SEED_DEMO=true

# Origin yang boleh menampilkan aplikasi di dalam iframe (pisahkan dengan koma). Kosongkan
# untuk lokal. Hugging Face Spaces: https://huggingface.co
FRAME_ANCESTORS=

# Folder hasil build front-end yang akan disajikan Express (opsional, dipakai saat deploy satu layanan).
# Kosongkan jika front-end di-deploy terpisah.
STATIC_DIR=../front-end/dist
